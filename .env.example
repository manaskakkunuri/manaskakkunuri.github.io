# Copy to .env locally; never commit real secrets.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./ultron.db
ACCESS_TOKEN_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPI_ID=shreetulasi@oksbi
APP_ENV=development

# Provider secrets are backend-only. Rotate any key pasted into chat or committed accidentally.
GEMINI_API_KEY=add-your-google-ai-studio-key-here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Set this long random secret only after trusted payment reconciliation is ready.
PAYMENT_RECONCILIATION_SECRET=replace-with-a-long-random-ops-secret

# Google Identity Services OAuth Web Client ID (public ID, not a secret).
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
